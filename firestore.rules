rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    // Editors: a document in `editors` named by the lowercase Google email
    // (added in the Firebase console), or the older websiteEditor claim.
    function isOwner() {
      return isGoogleUser()
        && (request.auth.token.get('websiteEditor', false) == true
          || exists(/databases/$(database)/documents/editors/$(request.auth.token.email.lower())));
    }
    // Each user may check only their own entry; the list is managed in the
    // Firebase console, never from the website.
    match /editors/{email} {
      allow get: if isGoogleUser() && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }
    match /website/content {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['heroText', 'aboutText', 'insuranceText', 'contactText', 'contactEmail', 'staff', 'services', 'insurance'])
        && request.resource.data.heroText is string
        && request.resource.data.aboutText is string
        && request.resource.data.insuranceText is string
        && request.resource.data.contactText is string
        && request.resource.data.contactEmail is string
        && request.resource.data.staff is list
        && request.resource.data.services is list
        && request.resource.data.insurance is list;
      allow delete: if false;
    }
  }
}
